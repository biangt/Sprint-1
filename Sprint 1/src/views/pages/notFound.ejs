<main class="not-found">
  <%# La imagen ya trae el "404" y el mensaje dibujados adentro,
      por eso no se repite el texto encima. %>
  <img
    src="/assets/img/zeus404.jpg"
    alt="Perro triste con el texto: 404, la página que buscás no existe"
    class="not-found__banner"
  />

  <section class="not-found__actions">
    <h1>¿Buscabas algo en particular?</h1>
    <%# US#17: esta misma vista también se reutiliza cuando el id de un
        producto es inválido (400), no solo cuando no existe (404). Si el
        controller manda un "mensaje" propio, se muestra ese en vez del
        genérico. %>
    <p><%= typeof mensaje !== 'undefined' && mensaje ? mensaje : 'Esa página no existe, pero podés seguir mirando por acá.' %></p>
    <div class="not-found__buttons">
      <a href="/" class="btn btn--primary">Volver al inicio</a>
      <a href="/products" class="btn btn--secondary">Ver productos</a>
    </div>
  </section>
</main>
