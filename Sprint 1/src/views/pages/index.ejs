<%- include('../partials/organisms/categoryStrip', { categorias: categorias }) %>

<%- include('../partials/organisms/promoBanner') %>

<%# US#6: "sugeridos" son hasta 5 productos elegidos al azar por el
    controller (productController.showHome), y "masPedidos" es el resto
    del catálogo, sin repetir los que ya se muestran arriba. %>
<main>
  <%- include('../partials/organisms/productGrid', { productos: sugeridos, titulo: 'Te puede interesar' }) %>
  <%- include('../partials/organisms/productGrid', { productos: masPedidos, titulo: 'Los más pedidos' }) %>

  <%# US#18: la Home solo muestra una selección (sugeridos + destacados),
      nunca el catálogo entero. Este bloque es la puerta hacia /products,
      donde vive el listado completo y el filtro de orden por precio. %>
  <section class="view-all">
    <p>¿Buscás algo puntual?</p>
    <a href="/products" class="btn btn--primary">Ver todos los productos</a>
  </section>
</main>

<%- include('../partials/organisms/categoryStrip', { categorias: categorias }) %>
