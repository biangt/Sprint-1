<%# Este organismo muestra la franja de categorías con ícono + nombre, %>
<%# tal como aparece en el diseño de Figma (fondo oscuro, en fila). %>
<%# categorias es el arreglo recibido desde la vista que incluye este partial. %>
<%
  /* El SVG de cada ícono ahora es un ATRIBUTO más de cada categoría
     (campo "icono" en data/categorias.json), no algo hardcodeado acá.
     Así, agregar una categoría nueva con su propio ícono es solo agregar
     el objeto al JSON: esta vista no necesita tocarse nunca más para eso.

     ICONO_POR_DEFECTO es una red de seguridad: si algún día una categoría
     llega sin el campo "icono" (por ejemplo, alguien la agrega a mano y
     se olvida de ese campo), usamos esta cajita genérica en vez de romper
     el render o dejar el espacio vacío. */
  const ICONO_POR_DEFECTO = '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3.5" y="9" width="17" height="10.5" rx="1" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 12.5h17M12 9v10.5" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 9C8.5 6.5 10 5 12 5s3.5 1.5 3.5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
%>
<nav class="category-strip" aria-label="Categorías">
  <% categorias.forEach(function(categoria) { %>
    <%# US#10: antes apuntaba a /products?categoria=..., una ruta que nunca
        se llegó a programar. Ahora enlaza a la página real de categoría. %>
    <a href="/categories/<%= categoria.slug %>" class="category-strip__item">
      <%# La etiqueta con guion (sin signo igual) imprime el SVG SIN escapar
          las etiquetas HTML. Esto es seguro acá porque "icono" viene de
          nuestro propio archivo data/categorias.json (nosotros lo escribimos),
          nunca de algo que haya tipeado una persona usuaria. Si "icono"
          viniera de un formulario o de afuera, imprimirlo sin escapar sería
          un riesgo de seguridad (inyección de HTML/XSS) y habría que
          sanitizarlo antes. %>
      <span class="category-strip__icon"><%- categoria.icono || ICONO_POR_DEFECTO %></span>
      <span class="category-strip__label"><%= categoria.nombre %></span>
    </a>
  <% }) %>
</nav>
