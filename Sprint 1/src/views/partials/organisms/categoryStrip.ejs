<%# Este organismo muestra la franja de categorías con ícono + nombre, %>
<%# tal como aparece en el diseño de Figma (fondo oscuro, en fila). %>
<%# categorias es el arreglo recibido desde la vista que incluye este partial. %>
<%
  /* Mapa de ícono SVG por slug de categoría. Si en el futuro se agrega una
     categoría nueva y no está en este mapa, se usa "otros" como ícono por
     defecto para no romper el render. */
  const categoryIcons = {
    electronica: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="12" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M8 20h8M12 16v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
    alimentos: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 9c0-1.5 3.6-3 8-3s8 1.5 8 3-3.6 2-8 2-8-0.5-8-2Z" stroke="currentColor" stroke-width="1.6"/><path d="M4 9c0 3.5 16 3.5 16 0M5 13.5h14a1 1 0 0 1 1 1.2l-.4 1.6a2 2 0 0 1-1.9 1.5H6.3a2 2 0 0 1-1.9-1.5l-.4-1.6a1 1 0 0 1 1-1.2Z" stroke="currentColor" stroke-width="1.6"/></svg>',
    bebidas: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3h12l-1.2 15.2A2 2 0 0 1 14.8 20H9.2a2 2 0 0 1-2-1.8L6 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M5 3h14M8 9h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
    indumentaria: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 4 5 6.5 3 10l3 2v8h12v-8l3-2-2-3.5L15 4a3 3 0 0 1-6 0Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
    juegos: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2.5" y="8" width="19" height="10" rx="4" stroke="currentColor" stroke-width="1.6"/><path d="M7 11v4M5 13h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="16.2" cy="12" r="0.9" fill="currentColor"/><circle cx="18.2" cy="14.5" r="0.9" fill="currentColor"/></svg>',
    automotor: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.3" stroke="currentColor" stroke-width="1.6"/><path d="M12 5.5v4M12 14.5v4M6.3 8.3l3 2.2M14.7 13.5l3 2.2M6.3 15.7l3-2.2M14.7 10.5l3-2.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
    hogar: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 11 12 4l8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 10v9h12v-9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M10 19v-5h4v5" stroke="currentColor" stroke-width="1.6"/></svg>',
    otros: '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3.5" y="9" width="17" height="10.5" rx="1" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 12.5h17M12 9v10.5" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 9C8.5 6.5 10 5 12 5s3.5 1.5 3.5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
  };
%>
<nav class="category-strip" aria-label="Categorías">
  <% categorias.forEach(function(categoria) { %>
    <a href="/products?categoria=<%= categoria.slug %>" class="category-strip__item">
      <span class="category-strip__icon"><%- categoryIcons[categoria.slug] || categoryIcons.otros %></span>
      <span class="category-strip__label"><%= categoria.nombre %></span>
    </a>
  <% }) %>
</nav>