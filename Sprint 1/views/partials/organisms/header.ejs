<%# Este organismo construye la cabecera comun de las paginas del sitio. %>
<%# <header> identifica semanticamente la parte superior de una pagina. %>
<header class="site-header">
  <%- include('../atoms/logo') %>
  <div class="site-header__search">
    <%- include('../molecules/searchBar') %>
  </div>
  <div class="site-header__actions">
    <%- include('../molecules/cartButton', { cantidad: typeof cantidadCarrito !== 'undefined' ? cantidadCarrito : 0 }) %>
    <%- include('../molecules/userMenu', { nombre: typeof usuarioNombre !== 'undefined' ? usuarioNombre : 'Invitado' }) %>
  </div>
</header>
