<%# a crea un enlace navegable hacia otra URL. %>
<%# href contiene la direccion de destino. %>
<a href="/" class="logo">
  <%# src indica la ruta del archivo de imagen que se debe cargar. %>
  <%# /assets/img/Zeus-horizontal.png es una ruta absoluta desde la raiz publica del sitio. %>
  <%# alt ofrece un texto alternativo para accesibilidad si la imagen no se ve. %>
  <img src="/assets/img/Zeus-horizontal.png" alt="ZEUS" />
</a>
